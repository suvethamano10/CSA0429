#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main() {
    int fd;
    char buffer[100];

    fd = open("sample.txt", O_CREAT | O_RDWR, 0644);
    write(fd, "Hello UNIX\n", 11);
    lseek(fd, 0, SEEK_SET);
    read(fd, buffer, 11);
    write(1, buffer, 11);
    close(fd);

    return 0;
}
