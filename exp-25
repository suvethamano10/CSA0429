#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main() {
    struct stat fileStat;
    DIR *d;
    struct dirent *dir;

    int fd = open("sample.txt", O_RDONLY);
    fcntl(fd, F_SETFL, O_APPEND);
    lseek(fd, 0, SEEK_SET);

    stat("sample.txt", &fileStat);
    printf("File Size: %ld\n", fileStat.st_size);

    d = opendir(".");
    while((dir = readdir(d)) != NULL)
        printf("%s\n", dir->d_name);

    closedir(d);
    close(fd);
    return 0;
}
