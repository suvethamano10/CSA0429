#include <stdio.h>
#include <stdlib.h>

int main() {
    int req[50], n, head, total = 0, i;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
        scanf("%d", &req[i]);

    printf("Enter initial head: ");
    scanf("%d", &head);

    for(i = 0; i < n; i++) {
        total += abs(req[i] - head);
        head = req[i];
    }

    printf("Total Seek Time (C-SCAN simplified): %d\n", total);
    return 0;
}
