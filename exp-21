#include <stdio.h>

int main() {
    int b[20], p[20], allocation[20];
    int m, n, i, j, worst;

    printf("Enter number of blocks: ");
    scanf("%d", &m);
    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("Enter size of blocks:\n");
    for(i = 0; i < m; i++)
        scanf("%d", &b[i]);

    printf("Enter size of processes:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &p[i]);

    for(i = 0; i < n; i++) {
        worst = -1;
        for(j = 0; j < m; j++) {
            if(b[j] >= p[i]) {
                if(worst == -1 || b[j] > b[worst])
                    worst = j;
            }
        }

        if(worst != -1) {
            allocation[i] = worst;
            b[worst] -= p[i];
        } else {
            allocation[i] = -1;
        }
    }

    printf("\nProcess\tBlock\n");
    for(i = 0; i < n; i++) {
        printf("%d\t", i+1);
        if(allocation[i] != -1)
            printf("%d\n", allocation[i]+1);
        else
            printf("Not Allocated\n");
    }
    return 0;
}
